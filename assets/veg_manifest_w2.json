{
 "schema": "negobs_veg_manifest",
 "version": "w2-a4-v1",
 "generated": "2026-07-29",
 "scope": "W2-A4 식생·텍스처 조달 + 픽셀 검증. 판정은 수종명이 아니라 메시 UV 가 실제로 샘플하는 픽셀로 한다.",
 "method": {
  "geometry": "usd-core 26.8 (CPU). Σ(faceVertexCount−2); PointInstancer 는 protoIndices 를 전개해 tri_effective 산출. 치수는 스테이지 전체 월드 바운딩(default+render+proxy).",
  "pixels": "UsdShade.MaterialBindingAPI → MDL → texture_2d() → 메시의 primvars:st 를 그 텍스처에 실제 샘플. HSV 색상각 분류, 채도>0.15 만 유채색. 텍스처 통계는 별도로 1024² LANCZOS 리샘플 전 픽셀.",
  "albedo": "sRGB→선형 IEC 61966-2-1 후 Rec.709 휘도 평균.",
  "gate_woody": "초록(65~170°)+황록(40~65°) ≥ 0.75 AND 적(0~25/340~360)+분홍(280~340)+주황(25~40) ≤ 0.06 AND (황록 우세면 선형 알베도 ≤ 0.55)",
  "gate_turf": "초록+황록 ≥ 0.75 AND 적+분홍 ≤ 0.02 AND 주황(마른 잎) ≤ 0.25 — 잔디의 짚색은 계절이 아니라 연중 상존이라 별도 게이트 [추정]",
  "gpu": "미사용. 렌더·Isaac·SMOKE 전부 미실행."
 },
