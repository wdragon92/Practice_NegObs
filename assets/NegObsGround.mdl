/*
 * NegObsGround.mdl — NegObs 룩 체크 전용 지면 재질 (OmniPBR 호환 축약형 + 확장)
 *
 * 왜 커스텀 MDL인가 (판정관 지적 대응):
 *  - B2(치명, r3): OmniPBR의 project_uvw(월드 큐빅 투영)는 투영축 선택이
 *    픽셀 단위 하드 스위치라 55~60° 경사벽(특히 대각 방위)에서 지배축이
 *    어긋나 텍스처가 낙하 방향으로 잡아늘여진다. 여기서는 노멀 가중
 *    3평면(triplanar) 소프트 블렌딩으로 교체 — 어느 방위의 벽에서도
 *    최악 늘어남이 √2 이내로 제한되고 축 전환 이음매가 없다.
 *  - A9/B3(치명): face 단위 GeomSubset 이진 분류는 재질 경계가 5cm 삼각형
 *    톱니로 노출된다. 여기서는 mesh 정점 primvar(blend_tw/blend_wb)를
 *    scene::data_lookup_float 로 읽어 두 텍스처 세트를 픽셀 단위로
 *    크로스페이드한다 (경계 대역 전용 블렌드 재질).
 *  - B1/B8(치명/경미): 단일 타일 반복 파괴 — ① 파장 10~20m 저주파 albedo
 *    명도·채도 변조(±10~15%), ② 90° 회전 오프셋 패치 혼합(월드 노이즈
 *    마스크), ③ 밝은 스페클(잔돌) 채도 억제(desat_bright — 보라빛 돌을
 *    중성 회색으로).
 *  - B6: roughness 공간 노이즈 변조 — 광택이 연속 띠가 아니라 습윤 얼룩
 *    패치로만 나타나게.
 *
 * BSDF는 OmniPBRBase의 metalness=0/coat 없음 경로를 그대로 축약 이식.
 *
 * ---------------------------------------------------------------------------
 * v1.6.0 (2026-07-28) — 사실화 라운드 Phase 2 항목 2-5 / 2-6 (절차 웨더링)
 *
 *   브리프 `Docs/briefs/realism_brief_v1.md` 개정이력 rev.1 §Phase 2 항목
 *   5(접지 AO·오염 링) · 6(웨더링 마스크), 그리고 v5.1 피드백 §4
 *   "기단 오염 밴드(h0.3 암화)" 를 **재질 계층 절차 마스크**로 전면화한 것.
 *
 *   추가 1. `negobs_noise_aniso` — 축별 파장이 다른 월드 노이즈(줄무늬용).
 *   추가 2. `negobs_weather` — 마스크 4종을 (암화 / 채도억제 / 조도) 3값으로
 *           환원해 돌려주는 순수 함수. 재질 let 블록에서 A/B 블렌드가 끝난
 *           **최종 albedo·rough 에 1회만** 적용된다(레이어별 중복 없음).
 *             ① 기단 오염 밴드 + 접지 AO : 월드 Z 그라디언트, 경계는
 *                smoothstep + 월드 노이즈 프랙탈화(하드 라인 금지)
 *             ② 스플래시 존              : 지면 0.15~0.50 m 대역 튐 자국
 *             ③ 상향면 먼지              : 월드 normal.z > 0.6 인 면
 *             ④ 하향 줄무늬(streaking)   : 수직면, 수평 파장 짧게·수직 길게
 *
 *   **회귀 위험 0 설계**: 4개 강도(`grime_strength` / `splash_strength` /
 *   `dust_strength` / `streak_strength`)와 2개 채도 노브가 전부 기본 0 이고,
 *   `negobs_weather` 는 4강도가 모두 0 이면 노이즈 페치조차 하지 않고
 *   (0,0,0) 을 즉시 반환한다. 적용식도 lerp(x,·,0)·x*(1-0)·clamp(x+0) 이라
 *   부동소수점 항등 — 기본값 렌더는 v1.5.0 과 **픽셀 단위로 동일**하다.
 *
 *   ※ v1.5.0 의 4건(patch_mix 노출 / round_edges / saturation /
 *      수평면 기저 축퇴 버그 수정 `horiz_gate`)은 일체 손대지 않았다.
 */

mdl 1.7;

import ::df::*;
import ::state::*;
import ::math::*;
import ::base::*;
import ::tex::*;
import ::anno::*;
import ::scene::*;

// 월드 공간 [m] 파장 노이즈 (재질 인스턴스가 달라도 같은 위치·파장·phase면
// 동일 값 → 경계 대역과 순수 영역의 변조가 이음매 없이 이어진다)
float negobs_noise(float wavelength, uniform int levels, uniform float phase)
{
    return base::perlin_noise_texture(
        uvw: base::transform_coordinate(
            transform: base::rotation_translation_scale(
                scaling: float3(1.0 / wavelength),
                rotation: float3(0.0),
                translation: float3(0.0)),
            coordinate: base::coordinate_source(
                coordinate_system: base::texture_coordinate_world,
                texture_space: 0)),
        color1: color(0.0),
        color2: color(1.0),
        size: 1.0,
        noise_phase: phase,
        noise_levels: levels).mono;
}

// [v1.6.0] 축별 파장이 다른 월드 노이즈. 하향 줄무늬(streaking)용 —
// 수평 파장을 짧게(줄이 가늘게), 수직 파장을 길게(줄이 아래로 길게) 준다.
// negobs_noise 와 별개 함수로 둔 이유: 기존 함수 시그니처를 건드리면
// 전 호출부(디더·패치·macro·rough·경계 노이즈 6곳)가 회귀 위험에 들어간다.
float negobs_noise_aniso(float3 wavelength, uniform int levels,
                         uniform float phase)
{
    return base::perlin_noise_texture(
        uvw: base::transform_coordinate(
            transform: base::rotation_translation_scale(
                scaling: float3(1.0 / wavelength.x,
                                1.0 / wavelength.y,
                                1.0 / wavelength.z),
                rotation: float3(0.0),
                translation: float3(0.0)),
            coordinate: base::coordinate_source(
                coordinate_system: base::texture_coordinate_world,
                texture_space: 0)),
        color1: color(0.0),
        color2: color(1.0),
        size: 1.0,
        noise_phase: phase,
        noise_levels: levels).mono;
}

struct NegObsTexSample
{
    color alb;
    float rough;
    float3 nrm;
};

// 한 기저(3개 직교 투영 평면)에 대한 triplanar 샘플.
//   p  : 기저 좌표계의 월드 위치 (기저가 Z축 회전이면 회전된 좌표)
//   aw : 기저 좌표계 |노멀| (디더링 적용 후)
//   bx/by/bz : 기저 축의 내부(internal) 좌표계 벡터 — 노멀맵 탄젠트용
NegObsTexSample negobs_sample_basis(
    uniform texture_2d diff_tex,
    uniform texture_2d nor_tex,
    uniform texture_2d rough_tex,
    float4x4 xf,
    uniform float bump,
    uniform bool flip_u,
    uniform bool flip_v,
    float3 p,
    float3 aw,
    float3 bx,
    float3 by,
    float3 bz,
    uniform float wexp)
{
    // 평면 가중: |n|^wexp (판정 B2 r5: ^4→^6 — 축 전환 대역 협소화)
    float wx = math::pow(aw.x, wexp);
    float wy = math::pow(aw.y, wexp);
    float wz = math::pow(aw.z, wexp);
    float wsum = wx + wy + wz;
    wx /= wsum;
    wy /= wsum;
    wz /= wsum;

    base::texture_coordinate_info uvw_z = base::transform_coordinate(
        transform: xf,
        coordinate: base::texture_coordinate_info(
            position: float3(p.x, p.y, 0.0),
            tangent_u: bx, tangent_v: by));
    base::texture_coordinate_info uvw_y = base::transform_coordinate(
        transform: xf,
        coordinate: base::texture_coordinate_info(
            position: float3(p.x, p.z, 0.0),
            tangent_u: bx, tangent_v: bz));
    base::texture_coordinate_info uvw_x = base::transform_coordinate(
        transform: xf,
        coordinate: base::texture_coordinate_info(
            position: float3(p.y, p.z, 0.0),
            tangent_u: by, tangent_v: bz));

    // [사실화 v1] diffuse 텍스처가 없어도 동작해야 한다 — 상수색 재질 대응.
    // 33씬 make_pbr 호출의 절반 이상(106/205)이 diffuse_color 상수색이고,
    // 상수색은 **완전 평탄**이라 flat% 의 최대 발생원이다. 텍스처를 새로
    // 조달하지 않고도, 이 MDL 이 이미 가진 월드 노이즈·macro 변조·웨더링을
    // 상수색 위에 그대로 태울 수 있다. 텍스처 부재 시 흰색(1,1,1)을 반환하면
    // 이후 base_color 곱셈으로 원래 상수색이 복원되고 변조만 얹힌다.
    bool has_d = tex::texture_isvalid(diff_tex);
    color a_z = has_d ? base::file_texture(texture: diff_tex, uvw: uvw_z).tint
                      : color(1.0);
    color a_y = has_d ? base::file_texture(texture: diff_tex, uvw: uvw_y).tint
                      : color(1.0);
    color a_x = has_d ? base::file_texture(texture: diff_tex, uvw: uvw_x).tint
                      : color(1.0);

    bool has_r = tex::texture_isvalid(rough_tex);
    float r_z = has_r ? tex::lookup_float3(
        tex: rough_tex,
        coord: float2(uvw_z.position.x, uvw_z.position.y)).x : 0.5;
    float r_y = has_r ? tex::lookup_float3(
        tex: rough_tex,
        coord: float2(uvw_y.position.x, uvw_y.position.y)).x : 0.5;
    float r_x = has_r ? tex::lookup_float3(
        tex: rough_tex,
        coord: float2(uvw_x.position.x, uvw_x.position.y)).x : 0.5;

    bool has_n = tex::texture_isvalid(nor_tex);
    float3 n_z = has_n ? base::tangent_space_normal_texture(
        texture: nor_tex, factor: bump,
        flip_tangent_u: flip_u, flip_tangent_v: flip_v,
        uvw: uvw_z) : state::normal();
    float3 n_y = has_n ? base::tangent_space_normal_texture(
        texture: nor_tex, factor: bump,
        flip_tangent_u: flip_u, flip_tangent_v: flip_v,
        uvw: uvw_y) : state::normal();
    float3 n_x = has_n ? base::tangent_space_normal_texture(
        texture: nor_tex, factor: bump,
        flip_tangent_u: flip_u, flip_tangent_v: flip_v,
        uvw: uvw_x) : state::normal();

    NegObsTexSample S;
    S.alb = a_x * wx + a_y * wy + a_z * wz;
    S.rough = r_x * wx + r_y * wy + r_z * wz;
    S.nrm = math::normalize(n_x * wx + n_y * wy + n_z * wz);
    return S;
}

// 텍스처 세트 1개를 노멀 가중 triplanar로 샘플 (판정 B2 치명 대응).
// 판정 B2(r5, lip_along): axis-aligned 기저만으로는 방위 45° 경사면에서
// 어느 축을 선택해도 면내 √2 포어쇼트닝이 남는다 → Z축 45° 회전 보조 기저를
// 추가하고, 표면 노멀 방위가 어느 기저의 축에 더 가까운지로 기저를 선택
// (최대 방위 이탈 22.5° → 최대 신장 1/cos22.5°≈1.08). 선택 경계(22.5°)는
// 월드 고주파 노이즈로 디더링해 스위칭 라인이 입자 패치워크로 파쇄된다.
NegObsTexSample negobs_sample_tri(
    uniform texture_2d diff_tex,
    uniform texture_2d nor_tex,
    uniform texture_2d rough_tex,
    uniform float2 tex_scale,
    uniform float rot_deg,
    uniform float2 uv_offset,
    uniform float bump,
    uniform bool flip_u,
    uniform bool flip_v,
    uniform float tri_dither,
    uniform float tri_dither_wl,
    uniform float wexp)
{
    float3 pw = state::transform_point(
        state::coordinate_internal, state::coordinate_world,
        state::position());
    float3 nw = math::normalize(state::transform_normal(
        state::coordinate_internal, state::coordinate_world,
        state::normal()));

    // 판정 B2(r4→r5): 축 전환 대역(두 투영이 각각 늘어난 채 크로스페이드
    // → 결맞은 섬유상 스트리크 + 입자 소실)을 월드 고주파 노이즈로 가중치
    // 디더링 — 전이 대역이 '한 투영이 국소 지배하는 입자 스케일 패치워크'가
    // 되어 스트리크가 파쇄된다. r5: 파장을 입자 스케일(0.05~0.08m)로 낮춤.
    float d1 = 1.0 + tri_dither * (negobs_noise(tri_dither_wl, 2, 13.1) * 2.0 - 1.0);
    float d2 = 1.0 + tri_dither * (negobs_noise(tri_dither_wl, 2, 17.3) * 2.0 - 1.0);
    float d3 = 1.0 + tri_dither * (negobs_noise(tri_dither_wl, 2, 23.9) * 2.0 - 1.0);

    // 노멀맵 탄젠트 기저용 월드축 (내부 좌표계로 변환)
    float3 ex = state::transform_vector(
        state::coordinate_world, state::coordinate_internal,
        float3(1.0, 0.0, 0.0));
    float3 ey = state::transform_vector(
        state::coordinate_world, state::coordinate_internal,
        float3(0.0, 1.0, 0.0));
    float3 ez = state::transform_vector(
        state::coordinate_world, state::coordinate_internal,
        float3(0.0, 0.0, 1.0));

    // uv 회전·스케일·오프셋 공통 변환 행렬
    float4x4 xf = base::rotation_translation_scale(
        scaling: float3(tex_scale.x, tex_scale.y, 1.0),
        rotation: float3(0.0, 0.0, rot_deg / 180.0 * math::PI),
        translation: float3(uv_offset.x, uv_offset.y, 0.0));

    //  기저 0: axis-aligned (X/Y/Z)  //
    float3 aw0 = math::max(math::abs(nw) * float3(d1, d2, d3), float3(0.001));
    NegObsTexSample s_ax = negobs_sample_basis(
        diff_tex, nor_tex, rough_tex, xf, bump, flip_u, flip_v,
        pw, aw0, ex, ey, ez, wexp);

    //  기저 1: Z축 45° 회전 (X'=(X+Y)/√2, Y'=(Y-X)/√2)  //
    const float R2 = 0.70710678;
    float3 pr = float3((pw.x + pw.y) * R2, (pw.y - pw.x) * R2, pw.z);
    float3 nr = float3((nw.x + nw.y) * R2, (nw.y - nw.x) * R2, nw.z);
    float3 aw1 = math::max(math::abs(nr) * float3(d2, d3, d1), float3(0.001));
    float3 exr = (ex + ey) * R2;
    float3 eyr = (ey - ex) * R2;
    NegObsTexSample s_di = negobs_sample_basis(
        diff_tex, nor_tex, rough_tex, xf, bump, flip_u, flip_v,
        pr, aw1, exr, eyr, ez, wexp);

    //  기저 선택: 노멀 방위가 어느 기저의 축에 더 정렬돼 있나 (디더링)  //
    float axy = math::max(math::length(float2(nw.x, nw.y)), 1.0e-4);
    float q_ax = math::max(math::abs(nw.x), math::abs(nw.y)) / axy;
    float q_di = math::max(math::abs(nr.x), math::abs(nr.y)) / axy;
    // [사실화 v1 · 버그 수정] **수평면에서 기저 선택이 축퇴한다.**
    // nw=(0,0,1) 이면 axy→0 이라 q_ax = q_di = 0 → sel = smoothstep(...,0) = 0.5,
    // 즉 축정렬 기저와 45° 회전 기저가 **50:50으로 섞인다**. 45° 보조 기저는
    // 원래 '대각 방위 경사벽'의 늘어남을 잡으려고 만든 것이라 수평면에서는
    // 이득이 0인데, 방향성 있는 모듈 패턴(인터로킹 보도블록 등)을 45° 돌려버린다.
    // 한국 보도는 통행 방향과 나란히 깔린다 — 사선은 명백한 오류다.
    //   (TerrainGen 은 침식 도랑 지형이라 평탄 수평면이 거의 없어 드러나지 않았다.)
    // 처방: 경사도(axy = sin 경사각)로 게이팅해 수평면은 축정렬 기저만 쓴다.
    //   axy < 0.05 (경사 < 2.9°)  → sel = 0 (순수 축정렬)
    //   axy > 0.25 (경사 > 14.5°) → 종전 동작
    float horiz_gate = math::smoothstep(0.05, 0.25, axy);
    float sel = horiz_gate * math::smoothstep(-0.05, 0.05,
        q_di - q_ax +
        0.12 * tri_dither * (negobs_noise(tri_dither_wl, 2, 29.7) * 2.0 - 1.0));

    NegObsTexSample S;
    S.alb = math::lerp(s_ax.alb, s_di.alb, sel);
    S.rough = math::lerp(s_ax.rough, s_di.rough, sel);
    S.nrm = math::normalize(math::lerp(s_ax.nrm, s_di.nrm, sel));
    return S;
}

struct NegObsLayer
{
    color albedo;
    float rough;
    float3 nrm;
    float spec;
};

// 텍스처 세트 1개(albedo/normal/rough)의 최종 지각값:
// triplanar 샘플 + 90° 회전 패치 혼합 + 저주파 macro 명도·채도 변조 +
// 밝은 스페클 채도 억제 + roughness 노이즈까지 포함.
NegObsLayer negobs_layer(
    uniform texture_2d diff_tex,
    uniform texture_2d nor_tex,
    uniform texture_2d rough_tex,
    uniform float2 tex_scale,
    uniform float tex_rotate,
    uniform float rough_floor,
    uniform float rough_mult,
    uniform float bump,
    uniform bool flip_u,
    uniform bool flip_v,
    uniform float patch_mix,
    uniform float patch_wavelength,
    uniform float macro_amp,
    uniform float macro_wavelength,
    uniform float desat_bright,
    uniform float saturation,
    uniform float rough_noise,
    uniform float rough_noise_wavelength,
    uniform float spec,
    uniform float tri_dither,
    uniform float tri_dither_wl,
    uniform float wexp)
{
    // 기본 샘플 + 반복 파괴용 제2 샘플(+90° 회전, 비정수 오프셋)
    NegObsTexSample s1 = negobs_sample_tri(
        diff_tex, nor_tex, rough_tex, tex_scale, tex_rotate,
        float2(0.0, 0.0), bump, flip_u, flip_v, tri_dither, tri_dither_wl,
        wexp);

    // [사실화 v1 · 성능] **patch_mix=0 이면 s2 는 결과에 기여하지 않는데도
    // 종전에는 항상 계산했다.** s2 는 triplanar 2기저 × 3평면 × 3맵 = 최대 18회
    // 텍스처 페치 + 노이즈 다수라 레이어 비용의 절반이다.
    // 모듈형 포장·상수색 재질은 전부 patch_mix=0 이므로 여기서 통째로 건너뛴다.
    // (게이트 3차에서 sceneD3 가 22s → 404s 로 18배 느려진 주 원인.)
    // patch_mix 는 uniform 이라 이 분기는 컴파일 타임에 접힌다.
    if (patch_mix <= 0.0) {
        NegObsLayer L0;
        color alb0 = s1.alb * color(math::clamp(
            1.0 + macro_amp * (negobs_noise(macro_wavelength, 2, 0.0) * 2.0 - 1.0),
            0.0, 2.0));
        float lum0 = math::luminance(alb0);
        alb0 = math::lerp(color(lum0), alb0, math::clamp(
            1.0 + macro_amp * (negobs_noise(macro_wavelength, 2, 5.1) * 2.0 - 1.0),
            0.0, 1.3));
        alb0 = math::lerp(alb0, color(lum0),
                          desat_bright * math::smoothstep(0.45, 0.75, lum0));
        alb0 = math::lerp(color(lum0), alb0, saturation);
        L0.albedo = alb0;
        L0.rough = math::clamp(
            rough_floor + rough_mult * s1.rough +
            rough_noise * (negobs_noise(rough_noise_wavelength, 2, 11.3) * 2.0 - 1.0),
            0.02, 1.0);
        L0.nrm = s1.nrm;
        L0.spec = spec;
        return L0;
    }

    NegObsTexSample s2 = negobs_sample_tri(
        diff_tex, nor_tex, rough_tex, tex_scale, tex_rotate + 90.0,
        float2(0.37, 0.61), bump, flip_u, flip_v, tri_dither, tri_dither_wl,
        wexp);

    float patch_m = patch_mix *
        math::smoothstep(0.38, 0.62, negobs_noise(patch_wavelength, 2, 3.7));

    // 저주파 macro 변조 (B1/B8): 타일 주기(수 m)보다 훨씬 긴 파장.
    // 명도(macro)와 채도(sat_m)를 서로 다른 phase로 각각 ±macro_amp 변조.
    float macro = math::clamp(
        1.0 + macro_amp * (negobs_noise(macro_wavelength, 2, 0.0) * 2.0 - 1.0),
        0.0, 2.0);
    float sat_m = math::clamp(
        1.0 + macro_amp * (negobs_noise(macro_wavelength, 2, 5.1) * 2.0 - 1.0),
        0.0, 1.3);
    // roughness 공간 변조 (B6): 광택을 습윤 얼룩 패치화
    float rn = rough_noise *
        (negobs_noise(rough_noise_wavelength, 2, 11.3) * 2.0 - 1.0);

    color alb = math::lerp(s1.alb, s2.alb, patch_m) * color(macro);
    float lum = math::luminance(alb);
    // 채도 macro 변조 (중립 회색 <-> 원색 사이 보간·소폭 과포화 허용)
    alb = math::lerp(color(lum), alb, sat_m);
    // [사실화 v1] 역할별 채도 캘리브레이션.
    // 실측: 렌더 전역 sat_mu 0.298 vs 실사 0.158. 단 **전역 하향은 틀렸다** —
    // scene01 은 이미 0.146 으로 하한 미달이고, 과채도는 석재·초목·흙 계열의
    // 국소 현상이다(scene07 0.320 / sceneD3 0.306). 그래서 역할별 계수로 준다.
    // OmniPBR 에는 채도를 낮출 입력이 아예 없어 이 노브는 MDL 쪽에만 존재한다.
    // 1.0 = 원본 유지(기존 씬 회귀 0).
    alb = math::lerp(color(lum), alb, saturation);
    // 밝은 스페클(잔돌) 채도 억제 (B8): 밝은 픽셀일수록 회색 쪽으로
    alb = math::lerp(alb, color(lum),
                     desat_bright * math::smoothstep(0.45, 0.75, lum));

    NegObsLayer L;
    L.albedo = alb;
    L.rough = math::clamp(
        rough_floor + rough_mult * math::lerp(s1.rough, s2.rough, patch_m) + rn,
        0.02, 1.0);
    L.nrm = math::normalize(math::lerp(s1.nrm, s2.nrm, patch_m));
    L.spec = spec;
    return L;
}

// ---------------------------------------------------------------------------
// [v1.6.0] 절차 웨더링 (브리프 Phase 2 항목 2-5 / 2-6)
// ---------------------------------------------------------------------------
// 마스크 4종을 세 개의 스칼라로 환원한다. 이렇게 하면 A/B 두 텍스처 세트에
// 각각 적용할 필요 없이 **블렌드가 끝난 최종 albedo·rough 에 1회만** 적용하면
// 되고, negobs_layer / negobs_sample_tri 의 시그니처를 전혀 건드리지 않는다.
//   darken : albedo 곱연산 암화량   (albedo *= 1 - darken)
//   desat  : 채도 억제량            (albedo = lerp(albedo, gray, desat))
//   rough  : roughness 가산량       (때가 앉으면 광택이 죽는다)
struct NegObsWeather
{
    float darken;
    float desat;
    float rough;
};

// 모든 강도가 0 이면 노이즈 페치 없이 (0,0,0) 즉시 반환 → 기본값 무영향·무비용.
NegObsWeather negobs_weather(
    float3 pw,                              // 월드 위치 [m]
    float3 nw,                              // 월드 노멀 (정규화 완료)
    uniform float grime_z0,
    uniform float grime_height,
    uniform float grime_strength,
    uniform float grime_desat,
    uniform float grime_edge,
    uniform float grime_edge_wavelength,
    uniform float splash_strength,
    uniform float splash_low,
    uniform float splash_high,
    uniform float splash_wavelength,
    uniform float dust_strength,
    uniform float dust_desat,
    uniform float dust_wavelength,
    uniform float streak_strength,
    uniform float streak_wavelength,
    uniform float streak_length,
    uniform float weather_rough)
{
    NegObsWeather W;
    W.darken = 0.0;
    W.desat = 0.0;
    W.rough = 0.0;

    // 무영향 조기 반환. 조건이 전부 uniform 파라미터라 컴파일 타임에 접힌다.
    if (grime_strength <= 0.0 && splash_strength <= 0.0 &&
        dust_strength <= 0.0 && streak_strength <= 0.0) {
        return W;
    }

    //  ① 기단 오염 밴드 + 접지 AO  //
    // 실제 건물 기단·옹벽·연석은 빗물 튀김과 먼지 축적으로 하단 0.3~0.5 m 가
    // 눈에 띄게 어둡고 채도가 낮다. 경계는 하드 컷이 아니라 smoothstep 이며,
    // 밴드 상단 높이 자체를 월드 노이즈로 흔들어 직선 라인을 프랙탈화한다.
    float hz = (pw.z - grime_z0) + grime_edge *
        (negobs_noise(grime_edge_wavelength, 3, 41.3) * 2.0 - 1.0);
    float m_grime = 1.0 - math::smoothstep(
        0.0, math::max(grime_height, 1.0e-3), hz);

    //  ② 스플래시 존  //
    // 밴드 안쪽 0.15~0.50 m 대역의 '튐 자국'. 균질한 그라디언트가 아니라
    // 성긴 얼룩이어야 해서 고주파 노이즈를 threshold 해 반점화한다.
    float sp_lo = grime_z0 + splash_low;
    float sp_hi = grime_z0 + math::max(splash_high, splash_low + 1.0e-3);
    float st = math::clamp((pw.z - sp_lo) / (sp_hi - sp_lo), 0.0, 1.0);
    float sp_band = math::smoothstep(0.0, 0.25, st) *
                    (1.0 - math::smoothstep(0.55, 1.0, st));
    float sp_spk = math::smoothstep(
        0.52, 0.80, negobs_noise(splash_wavelength, 3, 31.7));
    float m_splash = sp_band * sp_spk;

    //  ③ 상향면 먼지  //
    // 수평에 가까운 면(normal.z > 0.6)에만 먼지가 앉는다. 저주파 얼룩으로
    // 변조해 균일한 필름이 되지 않게 한다.
    float m_dust = math::smoothstep(0.60, 0.85, nw.z) *
        math::lerp(0.55, 1.0, negobs_noise(dust_wavelength, 2, 43.1));

    //  ④ 하향 줄무늬(streaking)  //
    // 수직면에서 빗물이 아래로 흘러 남긴 자국. 수평 파장 짧게·수직 파장 길게
    // 늘린 월드 노이즈를 threshold 해 가늘고 긴 세로줄을 만든다.
    float m_vert = 1.0 - math::smoothstep(0.30, 0.60, math::abs(nw.z));
    float sn = negobs_noise_aniso(
        float3(math::max(streak_wavelength, 1.0e-3),
               math::max(streak_wavelength, 1.0e-3),
               math::max(streak_length, 1.0e-3)), 3, 53.9);
    float m_streak = m_vert * math::smoothstep(0.50, 0.80, sn);

    // 상한 0.95 — 순흑 패치 금지(v5.1 §4 의 "순백 대면적 금지"와 같은 취지).
    W.darken = math::clamp(
        grime_strength * m_grime + splash_strength * m_splash +
        dust_strength * m_dust + streak_strength * m_streak, 0.0, 0.95);
    W.desat = math::clamp(
        grime_desat * m_grime + dust_desat * m_dust, 0.0, 1.0);
    // 때가 앉은 만큼만 거칠어진다 — 강도 0 인 마스크는 여기에도 기여 못 한다.
    W.rough = weather_rough * W.darken;
    return W;
}

export material NegObsGround(
    //  텍스처 세트 A (항상 사용)  //
    uniform texture_2d diffuse_texture_a = texture_2d() [[
        anno::display_name("Albedo A") ]],
    uniform texture_2d normalmap_texture_a = texture_2d() [[
        anno::display_name("Normal A"), anno::usage("normal") ]],
    uniform texture_2d roughness_texture_a = texture_2d() [[
        anno::display_name("Roughness A"), anno::usage("roughness") ]],
    uniform float2 texture_scale_a = float2(1.0),
    uniform float texture_rotate_a = 0.0,
    uniform float rough_floor_a = 0.0,
    uniform float rough_mult_a = 1.0,
    uniform float patch_wavelength_a = 4.0,
    uniform float macro_amp_a = 0.0,
    uniform float macro_wavelength_a = 14.0,
    uniform float desat_bright_a = 0.0,
    uniform float saturation_a = 1.0 [[
        anno::display_name("Saturation A"),
        anno::description("역할별 채도 계수. 1.0=원본, <1=탈색") ]],
    uniform float rough_noise_a = 0.0,
    uniform float rough_noise_wavelength_a = 1.2,
    uniform float specular_level_a = 0.5,
    uniform float bump_factor_a = 1.0 [[
        anno::description("세트 A 노멀맵 강도 배율 (bump_factor에 곱)") ]],

    //  텍스처 세트 B (use_blend=true 인 경계 대역 재질에서만)  //
    uniform bool use_blend = false,
    uniform texture_2d diffuse_texture_b = texture_2d() [[
        anno::display_name("Albedo B") ]],
    uniform texture_2d normalmap_texture_b = texture_2d() [[
        anno::display_name("Normal B"), anno::usage("normal") ]],
    uniform texture_2d roughness_texture_b = texture_2d() [[
        anno::display_name("Roughness B"), anno::usage("roughness") ]],
    uniform float2 texture_scale_b = float2(1.0),
    uniform float texture_rotate_b = 0.0,
    uniform float rough_floor_b = 0.0,
    uniform float rough_mult_b = 1.0,
    uniform float patch_wavelength_b = 4.0,
    uniform float macro_amp_b = 0.0,
    uniform float macro_wavelength_b = 14.0,
    uniform float desat_bright_b = 0.0,
    uniform float saturation_b = 1.0,
    uniform float rough_noise_b = 0.0,
    uniform float rough_noise_wavelength_b = 1.2,
    uniform float specular_level_b = 0.5,
    uniform float bump_factor_b = 1.0 [[
        anno::description("세트 B 노멀맵 강도 배율 (bump_factor에 곱)") ]],

    //  블렌드 제어  //
    // scene::data_lookup_float는 이름이 const 리터럴이어야 하므로(MDLC C331)
    // primvar 이름은 bool 선택자로 고정: false→"blend_tw", true→"blend_wb"
    uniform bool blend_use_wb = false [[
        anno::description("정점 primvar 선택 — false: blend_tw, true: blend_wb") ]],
    uniform float blend_default = 0.0,
    uniform float blend_edge_noise = 0.5 [[
        anno::description("경계 프랙탈화 강도 — w(1-w) 가중이라 0/1 고정점 유지") ]],
    uniform float blend_edge_wavelength = 0.09,

    //  [사실화 v1] 반복 파괴 강도 — 역할별 제어  //
    // 종전에는 negobs_layer 호출부에 리터럴 1.0 으로 박혀 있어 **끌 수가 없었다**.
    // 90° 회전 패치 혼합은 자연 지면(흙·자갈·풀)에는 옳지만, 인터로킹 보도블록·
    // 타일처럼 **모듈 방향성이 있는 포장**에서는 패턴을 조각내 "파손된 보도"로
    // 보이게 만든다(감독 E9 실측). 모듈형 포장은 0.0, 자연 지면은 1.0.
    //  [사실화 v1] 상수색 베이스 — diffuse 텍스처가 없는 재질용  //
    // albedo 에 곱해진다. 기본 흰색(1,1,1) = 텍스처 재질에 완전 무영향.
    // 텍스처가 없을 때는 이 색이 곧 재질색이 되고, macro 변조·desat·웨더링이
    // 그 위에 얹혀 **평탄한 단색이 아니게** 된다.
    uniform color base_color = color(1.0) [[
        anno::display_name("Base Color"),
        anno::description("상수색 재질의 기본색. 텍스처 재질에서는 흰색 유지") ]],

    uniform float patch_mix_a = 1.0 [[
        anno::display_name("Patch Mix A"),
        anno::description("90도 회전 패치 혼합 강도. 모듈형 포장=0, 자연 지면=1") ]],
    uniform float patch_mix_b = 1.0 [[
        anno::display_name("Patch Mix B") ]],

    //  [사실화 v1] 가짜 베벨 — OmniPBR round_edges 동등 기능  //
    // 3단 재질 정책에서 지면·사면은 이 MDL 을 쓰는데, 연석·계단 코처럼 모서리가
    // 있는 지면 계열 프림이 OmniPBR 의 round_edges 를 못 쓰게 되는 문제가 있었다.
    // radius=0 이면 state::normal() 과 동일해 완전한 무영향(기존 씬 회귀 0).
    uniform float round_edges_radius = 0.0 [[
        anno::display_name("Round Edges Radius"),
        anno::description("모서리 반올림 반경 [m]. 0 = 끔") ]],
    uniform float round_edges_roundness = 1.0,
    uniform bool round_edges_across_materials = false,

    //  [사실화 v2 · 2-5] 접지 AO · 기단 오염 밴드  //
    // 월드 Z 그라디언트. 지면에 가까울수록 어둡고 채도가 낮다.
    // grime_strength = 0 (기본) 이면 negobs_weather 가 조기 반환 → 완전 무영향.
    uniform float grime_z0 = 0.0 [[
        anno::display_name("Grime Z0"),
        anno::description("오염 밴드 기준 월드 Z [m]. 보통 그 프림이 서 있는 지면 높이") ]],
    uniform float grime_height = 0.35 [[
        anno::display_name("Grime Height"),
        anno::description("밴드 높이 [m]. z0 에서 z0+h 까지 선형(smoothstep) 소멸") ]],
    uniform float grime_strength = 0.0 [[
        anno::display_name("Grime Strength"),
        anno::description("밴드 최대 암화량 0~1. **0 = 웨더링 전체 무영향**") ]],
    uniform float grime_desat = 0.0 [[
        anno::display_name("Grime Desaturation"),
        anno::description("밴드 내 채도 억제량 0~1 (때는 색을 잃는다). 권장 0.35") ]],
    uniform float grime_edge = 0.06 [[
        anno::description("밴드 상단 높이의 노이즈 요동 진폭 [m] — 직선 경계 방지") ]],
    uniform float grime_edge_wavelength = 0.25 [[
        anno::description("밴드 경계 프랙탈화 월드 파장 [m]") ]],

    //  [사실화 v2 · 2-6] 스플래시 존  //
    uniform float splash_strength = 0.0 [[
        anno::display_name("Splash Strength"),
        anno::description("빗물 튐 자국 암화량 0~1. 0 = 끔") ]],
    uniform float splash_low = 0.15 [[
        anno::description("튐 대역 하한 (z0 기준 상대 높이) [m]") ]],
    uniform float splash_high = 0.50 [[
        anno::description("튐 대역 상한 (z0 기준 상대 높이) [m]") ]],
    uniform float splash_wavelength = 0.12 [[
        anno::description("튐 반점 월드 파장 [m] — 작을수록 잘게 튄다") ]],

    //  [사실화 v2 · 2-6] 상향면 먼지  //
    uniform float dust_strength = 0.0 [[
        anno::display_name("Dust Strength"),
        anno::description("월드 normal.z>0.6 인 면의 밝기 저하 0~1. 0 = 끔") ]],
    uniform float dust_desat = 0.0 [[
        anno::display_name("Dust Desaturation"),
        anno::description("상향면 채도 저하 0~1. 권장 0.25") ]],
    uniform float dust_wavelength = 0.8 [[
        anno::description("먼지 얼룩 월드 파장 [m]") ]],

    //  [사실화 v2 · 2-6] 하향 줄무늬(streaking)  //
    uniform float streak_strength = 0.0 [[
        anno::display_name("Streak Strength"),
        anno::description("수직면 흘러내림 자국 암화량 0~1. 0 = 끔") ]],
    uniform float streak_wavelength = 0.18 [[
        anno::description("줄무늬 수평 파장 [m] — 줄 굵기") ]],
    uniform float streak_length = 3.0 [[
        anno::description("줄무늬 수직 파장 [m] — 줄 길이. 수평보다 훨씬 길게") ]],

    //  [사실화 v2] 웨더링 → roughness 결합  //
    uniform float weather_rough = 0.0 [[
        anno::display_name("Weather Roughness Gain"),
        anno::description("암화량 1 당 roughness 가산량. 0 = 끔, 권장 0.15") ]],

    //  공통  //
    uniform float bump_factor = 1.0,
    uniform bool flip_tangent_u = false,
    uniform bool flip_tangent_v = true,
    // 판정 B2(r4): triplanar 축 전환 대역 가중치 디더링 (0=끔)
    uniform float tri_dither = 0.0 [[
        anno::description("투영 가중치 노이즈 디더 강도 — 전이 대역 스트리크 파쇄") ]],
    uniform float tri_dither_wavelength = 0.15 [[
        anno::description("가중치 디더 월드 파장 [m]") ]],
    // 판정 B2(r5): 투영 가중 지수 — 클수록 축 전환 크로스페이드 대역이 좁아짐
    uniform float tri_weight_exp = 6.0 [[
        anno::description("triplanar |노멀| 가중 지수 (4=종전, 6~8 권장)") ]]
)
[[
    anno::display_name("NegObs Ground"),
    anno::description("Triplanar-projected PBR with primvar cross-fade blending and anti-tiling"),
    anno::author("NegObs look-check pipeline"),
    anno::version(1, 8, 0)
]] = let {

    NegObsLayer A = negobs_layer(
        diffuse_texture_a, normalmap_texture_a, roughness_texture_a,
        texture_scale_a, texture_rotate_a, rough_floor_a, rough_mult_a,
        bump_factor * bump_factor_a, flip_tangent_u, flip_tangent_v,
        patch_mix_a, patch_wavelength_a, macro_amp_a, macro_wavelength_a,
        desat_bright_a, saturation_a, rough_noise_a, rough_noise_wavelength_a,
        specular_level_a, tri_dither, tri_dither_wavelength, tri_weight_exp);

    NegObsLayer B = negobs_layer(
        diffuse_texture_b, normalmap_texture_b, roughness_texture_b,
        texture_scale_b, texture_rotate_b, rough_floor_b, rough_mult_b,
        bump_factor * bump_factor_b, flip_tangent_u, flip_tangent_v,
        patch_mix_b, patch_wavelength_b, macro_amp_b, macro_wavelength_b,
        desat_bright_b, saturation_b, rough_noise_b, rough_noise_wavelength_b,
        specular_level_b, tri_dither, tri_dither_wavelength, tri_weight_exp);

    // 정점 primvar 크로스페이드 + 고주파 노이즈로 경계 프랙탈화
    // (w(1-w) 가중 → w=0/1에서 노이즈 기여 0: 순수 영역 재질과 픽셀 연속)
    float w0 = use_blend
        ? math::clamp(blend_use_wb
                      ? scene::data_lookup_float("blend_wb", blend_default)
                      : scene::data_lookup_float("blend_tw", blend_default),
                      0.0, 1.0)
        : 0.0;
    float w = math::clamp(
        w0 + blend_edge_noise *
            (negobs_noise(blend_edge_wavelength, 2, 7.9) - 0.5) * 4.0 *
            w0 * (1.0 - w0),
        0.0, 1.0);

    color albedo = (use_blend ? math::lerp(A.albedo, B.albedo, w) : A.albedo)
                   * base_color;
    float rough = use_blend ? math::lerp(A.rough, B.rough, w) : A.rough;
    float3 nrm_tex = use_blend
        ? math::normalize(math::lerp(A.nrm, B.nrm, w)) : A.nrm;
    float spec = use_blend ? math::lerp(A.spec, B.spec, w) : A.spec;

    // [사실화 v2] 절차 웨더링 적용 (2-5 접지 AO·기단 오염 / 2-6 웨더링 마스크).
    // A/B 크로스페이드가 끝난 **최종 albedo·rough 에 1회만** 건다 — 기하 기반
    // 현상(월드 Z·면 방향)이라 텍스처 세트별로 달라야 할 이유가 없고, 레이어
    // 내부에 넣으면 경계 대역에서 두 번 곱해진다.
    //
    // 기본값 무영향 근거:
    //   4개 강도가 모두 0 → negobs_weather 조기 반환 → W = (0, 0, 0)
    //   → lerp(albedo, gray, 0) == albedo   (t=0 은 부동소수점 항등)
    //   → albedo * color(1.0 - 0.0) == albedo
    //   → clamp(rough + 0.0, 0.02, 1.0) == rough  (rough 는 negobs_layer 에서
    //      이미 같은 구간으로 clamp 되어 나오므로 재클램프가 멱등)
    //   → nrm 계열은 아예 건드리지 않는다.
    NegObsWeather WX = negobs_weather(
        pw: state::transform_point(
                state::coordinate_internal, state::coordinate_world,
                state::position()),
        nw: math::normalize(state::transform_normal(
                state::coordinate_internal, state::coordinate_world,
                state::normal())),
        grime_z0: grime_z0,
        grime_height: grime_height,
        grime_strength: grime_strength,
        grime_desat: grime_desat,
        grime_edge: grime_edge,
        grime_edge_wavelength: grime_edge_wavelength,
        splash_strength: splash_strength,
        splash_low: splash_low,
        splash_high: splash_high,
        splash_wavelength: splash_wavelength,
        dust_strength: dust_strength,
        dust_desat: dust_desat,
        dust_wavelength: dust_wavelength,
        streak_strength: streak_strength,
        streak_wavelength: streak_wavelength,
        streak_length: streak_length,
        weather_rough: weather_rough);

    color albedo_w = math::lerp(albedo, color(math::luminance(albedo)),
                                WX.desat) * color(1.0 - WX.darken);
    float rough_w = math::clamp(rough + WX.rough, 0.02, 1.0);

    // [사실화 v1] 가짜 베벨 합성.
    // state::rounded_corner_normal 은 **기하 노멀을 대체**하는 값이라 노멀맵
    // 섭동과 곱셈 합성이 안 된다. 대신 기하 노멀 대비 **편차를 1차로 가산**한다:
    //   final = normalize(nrm_tex + (rc - state::normal()))
    // radius=0 이면 rc == state::normal() 이므로 편차 0 = 완전 무영향이고,
    // 모서리 근방에서만 노멀이 반올림 방향으로 회전하면서 텍스처 디테일은 남는다.
    float3 rc = round_edges_radius > 0.0
        ? state::rounded_corner_normal(round_edges_radius,
                                       round_edges_across_materials,
                                       round_edges_roundness)
        : state::normal();
    float3 nrm = math::normalize(nrm_tex + (rc - state::normal()));

    //  BSDF — OmniPBRBase(metalness=0, coat 없음) 경로 축약 이식  //
    bsdf diffuse_bsdf = df::weighted_layer(
        weight: 1.0,
        layer: df::diffuse_reflection_bsdf(tint: albedo_w, roughness: 0.0),
        base: bsdf(),
        normal: nrm);

    float rough_sq = rough_w * rough_w;
    bsdf ggx_bsdf = df::microfacet_ggx_smith_bsdf(
        roughness_u: rough_sq,
        roughness_v: rough_sq,
        tint: color(1.0),
        mode: df::scatter_reflect);

    bsdf surf_bsdf = df::custom_curve_layer(
        normal_reflectivity: 0.08,
        grazing_reflectivity: 1.0,
        exponent: 5.0,
        weight: spec,
        layer: ggx_bsdf,
        base: diffuse_bsdf,
        normal: nrm);

} in material(
    surface: material_surface(scattering: surf_bsdf),
    geometry: material_geometry()
);
