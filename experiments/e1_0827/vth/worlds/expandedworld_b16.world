    <model name="cam_c000">
      <static>true</static>
      <pose>11.393800 6.712900 1.624300 0 0.087266 -1.570796</pose>
      <link name="link">
        <sensor name="s_c000" type="depth">
          <camera name="c_c000">
            <horizontal_fov>1.2043</horizontal_fov>
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>100</far></clip>
          </camera>
          <always_on>1</always_on>
          <update_rate>2.0</update_rate>
          <visualize>0</visualize>
          <plugin name="plug_c000" filename="libgazebo_ros_camera.so">
            <ros><namespace>/gzcam/c000</namespace></ros>
            <camera_name>cam</camera_name>
            <frame_name>gzcam_c000_optical</frame_name>
            <hack_baseline>0.0</hack_baseline>
            <min_depth>0.1</min_depth>
            <max_depth>100.0</max_depth>
          </plugin>
        </sensor>
      </link>
    </model>

