    <!-- ===== capture cameras (sensor-only links, no visible body) ===== -->
    <model name="cam_h03_d2">
      <static>true</static>
      <pose>10 0 0.3 0 0.174533 0</pose>
      <link name="link">
        <sensor name="h03_d2" type="camera">
          <camera name="h03_d2">
            <horizontal_fov>1.047198</horizontal_fov>
            <image><width>1920</width><height>1080</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>150</far></clip>
          </camera>
          <!-- 1 Hz on purpose.  The gazebo_ros_camera plugin holds a frame connection, so
               the sensor renders whether or not anyone is subscribed; with 9 cameras in the
               world this is the knob that keeps the GPU cost negligible next to training.
               Regenerate with --cams to drop cameras entirely if the GPU is contended. -->
          <always_on>0</always_on>
          <update_rate>1.0</update_rate>
          <visualize>0</visualize>
          <plugin name="plug_h03_d2" filename="libgazebo_ros_camera.so">
            <ros><namespace>/gzcam/h03_d2</namespace></ros>
            <camera_name>cam</camera_name>
            <frame_name>gzcam_h03_d2_optical</frame_name>
            <hack_baseline>0.0</hack_baseline>
          </plugin>
        </sensor>
      </link>
    </model>
