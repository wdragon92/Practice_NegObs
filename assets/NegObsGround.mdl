/*
 * NegObsGround.mdl — NegObs 룩 체크 전용 지면 재질 (OmniPBR 호환 축약형 + 확장)
 *
 * 왜 커스텀 MDL인가 (판정관 지적 대응):
 *  - B2(치명, r3): OmniPBR의 project_uvw(월드 큐빅 투영)는 투영축 선택이
 *    픽셀 단위 하드 스위치라 55~60° 경사벽(특히 대각 방위)에서 지배축이
 *    어긋나 텍스처가 낙하 방향으로 잡아늘여진다. 여기서는 노멀 가중
 *    3평면(triplanar) 소프트 블렌딩으로 교체 — 어느 방위의 벽에서도
 *    최악 늘어남이 √2 이내로 제한되고 축 전환 이음매가 없다.
 *  - A9/B3(치명): face 단위 GeomSubset 이진 분류는 재질 경계가 5cm 삼각형
 *    톱니로 노출된다. 여기서는 mesh 정점 primvar(blend_tw/blend_wb)를
 *    scene::data_lookup_float 로 읽어 두 텍스처 세트를 픽셀 단위로
 *    크로스페이드한다 (경계 대역 전용 블렌드 재질).
 *  - B1/B8(치명/경미): 단일 타일 반복 파괴 — ① 파장 10~20m 저주파 albedo
 *    명도·채도 변조(±10~15%), ② 90° 회전 오프셋 패치 혼합(월드 노이즈
 *    마스크), ③ 밝은 스페클(잔돌) 채도 억제(desat_bright — 보라빛 돌을
 *    중성 회색으로).
 *  - B6: roughness 공간 노이즈 변조 — 광택이 연속 띠가 아니라 습윤 얼룩
 *    패치로만 나타나게.
 *
 * BSDF는 OmniPBRBase의 metalness=0/coat 없음 경로를 그대로 축약 이식.
 */

mdl 1.7;

import ::df::*;
import ::state::*;
import ::math::*;
import ::base::*;
import ::tex::*;
import ::anno::*;
import ::scene::*;

// 월드 공간 [m] 파장 노이즈 (재질 인스턴스가 달라도 같은 위치·파장·phase면
// 동일 값 → 경계 대역과 순수 영역의 변조가 이음매 없이 이어진다)
float negobs_noise(float wavelength, uniform int levels, uniform float phase)
{
    return base::perlin_noise_texture(
        uvw: base::transform_coordinate(
            transform: base::rotation_translation_scale(
                scaling: float3(1.0 / wavelength),
                rotation: float3(0.0),
                translation: float3(0.0)),
            coordinate: base::coordinate_source(
                coordinate_system: base::texture_coordinate_world,
                texture_space: 0)),
        color1: color(0.0),
        color2: color(1.0),
        size: 1.0,
        noise_phase: phase,
        noise_levels: levels).mono;
}

struct NegObsTexSample
{
    color alb;
    float rough;
    float3 nrm;
};

// 한 기저(3개 직교 투영 평면)에 대한 triplanar 샘플.
//   p  : 기저 좌표계의 월드 위치 (기저가 Z축 회전이면 회전된 좌표)
//   aw : 기저 좌표계 |노멀| (디더링 적용 후)
//   bx/by/bz : 기저 축의 내부(internal) 좌표계 벡터 — 노멀맵 탄젠트용
NegObsTexSample negobs_sample_basis(
    uniform texture_2d diff_tex,
    uniform texture_2d nor_tex,
    uniform texture_2d rough_tex,
    float4x4 xf,
    uniform float bump,
    uniform bool flip_u,
    uniform bool flip_v,
    float3 p,
    float3 aw,
    float3 bx,
    float3 by,
    float3 bz,
    uniform float wexp)
{
    // 평면 가중: |n|^wexp (판정 B2 r5: ^4→^6 — 축 전환 대역 협소화)
    float wx = math::pow(aw.x, wexp);
    float wy = math::pow(aw.y, wexp);
    float wz = math::pow(aw.z, wexp);
    float wsum = wx + wy + wz;
    wx /= wsum;
    wy /= wsum;
    wz /= wsum;

    base::texture_coordinate_info uvw_z = base::transform_coordinate(
        transform: xf,
        coordinate: base::texture_coordinate_info(
            position: float3(p.x, p.y, 0.0),
            tangent_u: bx, tangent_v: by));
    base::texture_coordinate_info uvw_y = base::transform_coordinate(
        transform: xf,
        coordinate: base::texture_coordinate_info(
            position: float3(p.x, p.z, 0.0),
            tangent_u: bx, tangent_v: bz));
    base::texture_coordinate_info uvw_x = base::transform_coordinate(
        transform: xf,
        coordinate: base::texture_coordinate_info(
            position: float3(p.y, p.z, 0.0),
            tangent_u: by, tangent_v: bz));

    color a_z = base::file_texture(texture: diff_tex, uvw: uvw_z).tint;
    color a_y = base::file_texture(texture: diff_tex, uvw: uvw_y).tint;
    color a_x = base::file_texture(texture: diff_tex, uvw: uvw_x).tint;

    bool has_r = tex::texture_isvalid(rough_tex);
    float r_z = has_r ? tex::lookup_float3(
        tex: rough_tex,
        coord: float2(uvw_z.position.x, uvw_z.position.y)).x : 0.5;
    float r_y = has_r ? tex::lookup_float3(
        tex: rough_tex,
        coord: float2(uvw_y.position.x, uvw_y.position.y)).x : 0.5;
    float r_x = has_r ? tex::lookup_float3(
        tex: rough_tex,
        coord: float2(uvw_x.position.x, uvw_x.position.y)).x : 0.5;

    bool has_n = tex::texture_isvalid(nor_tex);
    float3 n_z = has_n ? base::tangent_space_normal_texture(
        texture: nor_tex, factor: bump,
        flip_tangent_u: flip_u, flip_tangent_v: flip_v,
        uvw: uvw_z) : state::normal();
    float3 n_y = has_n ? base::tangent_space_normal_texture(
        texture: nor_tex, factor: bump,
        flip_tangent_u: flip_u, flip_tangent_v: flip_v,
        uvw: uvw_y) : state::normal();
    float3 n_x = has_n ? base::tangent_space_normal_texture(
        texture: nor_tex, factor: bump,
        flip_tangent_u: flip_u, flip_tangent_v: flip_v,
        uvw: uvw_x) : state::normal();

    NegObsTexSample S;
    S.alb = a_x * wx + a_y * wy + a_z * wz;
    S.rough = r_x * wx + r_y * wy + r_z * wz;
    S.nrm = math::normalize(n_x * wx + n_y * wy + n_z * wz);
    return S;
}

// 텍스처 세트 1개를 노멀 가중 triplanar로 샘플 (판정 B2 치명 대응).
// 판정 B2(r5, lip_along): axis-aligned 기저만으로는 방위 45° 경사면에서
// 어느 축을 선택해도 면내 √2 포어쇼트닝이 남는다 → Z축 45° 회전 보조 기저를
// 추가하고, 표면 노멀 방위가 어느 기저의 축에 더 가까운지로 기저를 선택
// (최대 방위 이탈 22.5° → 최대 신장 1/cos22.5°≈1.08). 선택 경계(22.5°)는
// 월드 고주파 노이즈로 디더링해 스위칭 라인이 입자 패치워크로 파쇄된다.
NegObsTexSample negobs_sample_tri(
    uniform texture_2d diff_tex,
    uniform texture_2d nor_tex,
    uniform texture_2d rough_tex,
    uniform float2 tex_scale,
    uniform float rot_deg,
    uniform float2 uv_offset,
    uniform float bump,
    uniform bool flip_u,
    uniform bool flip_v,
    uniform float tri_dither,
    uniform float tri_dither_wl,
    uniform float wexp)
{
    float3 pw = state::transform_point(
        state::coordinate_internal, state::coordinate_world,
        state::position());
    float3 nw = math::normalize(state::transform_normal(
        state::coordinate_internal, state::coordinate_world,
        state::normal()));

    // 판정 B2(r4→r5): 축 전환 대역(두 투영이 각각 늘어난 채 크로스페이드
    // → 결맞은 섬유상 스트리크 + 입자 소실)을 월드 고주파 노이즈로 가중치
    // 디더링 — 전이 대역이 '한 투영이 국소 지배하는 입자 스케일 패치워크'가
    // 되어 스트리크가 파쇄된다. r5: 파장을 입자 스케일(0.05~0.08m)로 낮춤.
    float d1 = 1.0 + tri_dither * (negobs_noise(tri_dither_wl, 2, 13.1) * 2.0 - 1.0);
    float d2 = 1.0 + tri_dither * (negobs_noise(tri_dither_wl, 2, 17.3) * 2.0 - 1.0);
    float d3 = 1.0 + tri_dither * (negobs_noise(tri_dither_wl, 2, 23.9) * 2.0 - 1.0);

    // 노멀맵 탄젠트 기저용 월드축 (내부 좌표계로 변환)
    float3 ex = state::transform_vector(
        state::coordinate_world, state::coordinate_internal,
        float3(1.0, 0.0, 0.0));
    float3 ey = state::transform_vector(
        state::coordinate_world, state::coordinate_internal,
        float3(0.0, 1.0, 0.0));
    float3 ez = state::transform_vector(
        state::coordinate_world, state::coordinate_internal,
        float3(0.0, 0.0, 1.0));

    // uv 회전·스케일·오프셋 공통 변환 행렬
    float4x4 xf = base::rotation_translation_scale(
        scaling: float3(tex_scale.x, tex_scale.y, 1.0),
        rotation: float3(0.0, 0.0, rot_deg / 180.0 * math::PI),
        translation: float3(uv_offset.x, uv_offset.y, 0.0));

    //  기저 0: axis-aligned (X/Y/Z)  //
    float3 aw0 = math::max(math::abs(nw) * float3(d1, d2, d3), float3(0.001));
    NegObsTexSample s_ax = negobs_sample_basis(
        diff_tex, nor_tex, rough_tex, xf, bump, flip_u, flip_v,
        pw, aw0, ex, ey, ez, wexp);

    //  기저 1: Z축 45° 회전 (X'=(X+Y)/√2, Y'=(Y-X)/√2)  //
    const float R2 = 0.70710678;
    float3 pr = float3((pw.x + pw.y) * R2, (pw.y - pw.x) * R2, pw.z);
    float3 nr = float3((nw.x + nw.y) * R2, (nw.y - nw.x) * R2, nw.z);
    float3 aw1 = math::max(math::abs(nr) * float3(d2, d3, d1), float3(0.001));
    float3 exr = (ex + ey) * R2;
    float3 eyr = (ey - ex) * R2;
    NegObsTexSample s_di = negobs_sample_basis(
        diff_tex, nor_tex, rough_tex, xf, bump, flip_u, flip_v,
        pr, aw1, exr, eyr, ez, wexp);

    //  기저 선택: 노멀 방위가 어느 기저의 축에 더 정렬돼 있나 (디더링)  //
    float axy = math::max(math::length(float2(nw.x, nw.y)), 1.0e-4);
    float q_ax = math::max(math::abs(nw.x), math::abs(nw.y)) / axy;
    float q_di = math::max(math::abs(nr.x), math::abs(nr.y)) / axy;
    float sel = math::smoothstep(-0.05, 0.05,
        q_di - q_ax +
        0.12 * tri_dither * (negobs_noise(tri_dither_wl, 2, 29.7) * 2.0 - 1.0));

    NegObsTexSample S;
    S.alb = math::lerp(s_ax.alb, s_di.alb, sel);
    S.rough = math::lerp(s_ax.rough, s_di.rough, sel);
    S.nrm = math::normalize(math::lerp(s_ax.nrm, s_di.nrm, sel));
    return S;
}

struct NegObsLayer
{
    color albedo;
    float rough;
    float3 nrm;
    float spec;
};

// 텍스처 세트 1개(albedo/normal/rough)의 최종 지각값:
// triplanar 샘플 + 90° 회전 패치 혼합 + 저주파 macro 명도·채도 변조 +
// 밝은 스페클 채도 억제 + roughness 노이즈까지 포함.
NegObsLayer negobs_layer(
    uniform texture_2d diff_tex,
    uniform texture_2d nor_tex,
    uniform texture_2d rough_tex,
    uniform float2 tex_scale,
    uniform float tex_rotate,
    uniform float rough_floor,
    uniform float rough_mult,
    uniform float bump,
    uniform bool flip_u,
    uniform bool flip_v,
    uniform float patch_mix,
    uniform float patch_wavelength,
    uniform float macro_amp,
    uniform float macro_wavelength,
    uniform float desat_bright,
    uniform float rough_noise,
    uniform float rough_noise_wavelength,
    uniform float spec,
    uniform float tri_dither,
    uniform float tri_dither_wl,
    uniform float wexp)
{
    // 기본 샘플 + 반복 파괴용 제2 샘플(+90° 회전, 비정수 오프셋)
    NegObsTexSample s1 = negobs_sample_tri(
        diff_tex, nor_tex, rough_tex, tex_scale, tex_rotate,
        float2(0.0, 0.0), bump, flip_u, flip_v, tri_dither, tri_dither_wl,
        wexp);
    NegObsTexSample s2 = negobs_sample_tri(
        diff_tex, nor_tex, rough_tex, tex_scale, tex_rotate + 90.0,
        float2(0.37, 0.61), bump, flip_u, flip_v, tri_dither, tri_dither_wl,
        wexp);

    float patch_m = patch_mix *
        math::smoothstep(0.38, 0.62, negobs_noise(patch_wavelength, 2, 3.7));

    // 저주파 macro 변조 (B1/B8): 타일 주기(수 m)보다 훨씬 긴 파장.
    // 명도(macro)와 채도(sat_m)를 서로 다른 phase로 각각 ±macro_amp 변조.
    float macro = math::clamp(
        1.0 + macro_amp * (negobs_noise(macro_wavelength, 2, 0.0) * 2.0 - 1.0),
        0.0, 2.0);
    float sat_m = math::clamp(
        1.0 + macro_amp * (negobs_noise(macro_wavelength, 2, 5.1) * 2.0 - 1.0),
        0.0, 1.3);
    // roughness 공간 변조 (B6): 광택을 습윤 얼룩 패치화
    float rn = rough_noise *
        (negobs_noise(rough_noise_wavelength, 2, 11.3) * 2.0 - 1.0);

    color alb = math::lerp(s1.alb, s2.alb, patch_m) * color(macro);
    float lum = math::luminance(alb);
    // 채도 macro 변조 (중립 회색 <-> 원색 사이 보간·소폭 과포화 허용)
    alb = math::lerp(color(lum), alb, sat_m);
    // 밝은 스페클(잔돌) 채도 억제 (B8): 밝은 픽셀일수록 회색 쪽으로
    alb = math::lerp(alb, color(lum),
                     desat_bright * math::smoothstep(0.45, 0.75, lum));

    NegObsLayer L;
    L.albedo = alb;
    L.rough = math::clamp(
        rough_floor + rough_mult * math::lerp(s1.rough, s2.rough, patch_m) + rn,
        0.02, 1.0);
    L.nrm = math::normalize(math::lerp(s1.nrm, s2.nrm, patch_m));
    L.spec = spec;
    return L;
}

export material NegObsGround(
    //  텍스처 세트 A (항상 사용)  //
    uniform texture_2d diffuse_texture_a = texture_2d() [[
        anno::display_name("Albedo A") ]],
    uniform texture_2d normalmap_texture_a = texture_2d() [[
        anno::display_name("Normal A"), anno::usage("normal") ]],
    uniform texture_2d roughness_texture_a = texture_2d() [[
        anno::display_name("Roughness A"), anno::usage("roughness") ]],
    uniform float2 texture_scale_a = float2(1.0),
    uniform float texture_rotate_a = 0.0,
    uniform float rough_floor_a = 0.0,
    uniform float rough_mult_a = 1.0,
    uniform float patch_wavelength_a = 4.0,
    uniform float macro_amp_a = 0.0,
    uniform float macro_wavelength_a = 14.0,
    uniform float desat_bright_a = 0.0,
    uniform float rough_noise_a = 0.0,
    uniform float rough_noise_wavelength_a = 1.2,
    uniform float specular_level_a = 0.5,
    uniform float bump_factor_a = 1.0 [[
        anno::description("세트 A 노멀맵 강도 배율 (bump_factor에 곱)") ]],

    //  텍스처 세트 B (use_blend=true 인 경계 대역 재질에서만)  //
    uniform bool use_blend = false,
    uniform texture_2d diffuse_texture_b = texture_2d() [[
        anno::display_name("Albedo B") ]],
    uniform texture_2d normalmap_texture_b = texture_2d() [[
        anno::display_name("Normal B"), anno::usage("normal") ]],
    uniform texture_2d roughness_texture_b = texture_2d() [[
        anno::display_name("Roughness B"), anno::usage("roughness") ]],
    uniform float2 texture_scale_b = float2(1.0),
    uniform float texture_rotate_b = 0.0,
    uniform float rough_floor_b = 0.0,
    uniform float rough_mult_b = 1.0,
    uniform float patch_wavelength_b = 4.0,
    uniform float macro_amp_b = 0.0,
    uniform float macro_wavelength_b = 14.0,
    uniform float desat_bright_b = 0.0,
    uniform float rough_noise_b = 0.0,
    uniform float rough_noise_wavelength_b = 1.2,
    uniform float specular_level_b = 0.5,
    uniform float bump_factor_b = 1.0 [[
        anno::description("세트 B 노멀맵 강도 배율 (bump_factor에 곱)") ]],

    //  블렌드 제어  //
    // scene::data_lookup_float는 이름이 const 리터럴이어야 하므로(MDLC C331)
    // primvar 이름은 bool 선택자로 고정: false→"blend_tw", true→"blend_wb"
    uniform bool blend_use_wb = false [[
        anno::description("정점 primvar 선택 — false: blend_tw, true: blend_wb") ]],
    uniform float blend_default = 0.0,
    uniform float blend_edge_noise = 0.5 [[
        anno::description("경계 프랙탈화 강도 — w(1-w) 가중이라 0/1 고정점 유지") ]],
    uniform float blend_edge_wavelength = 0.09,

    //  공통  //
    uniform float bump_factor = 1.0,
    uniform bool flip_tangent_u = false,
    uniform bool flip_tangent_v = true,
    // 판정 B2(r4): triplanar 축 전환 대역 가중치 디더링 (0=끔)
    uniform float tri_dither = 0.0 [[
        anno::description("투영 가중치 노이즈 디더 강도 — 전이 대역 스트리크 파쇄") ]],
    uniform float tri_dither_wavelength = 0.15 [[
        anno::description("가중치 디더 월드 파장 [m]") ]],
    // 판정 B2(r5): 투영 가중 지수 — 클수록 축 전환 크로스페이드 대역이 좁아짐
    uniform float tri_weight_exp = 6.0 [[
        anno::description("triplanar |노멀| 가중 지수 (4=종전, 6~8 권장)") ]]
)
[[
    anno::display_name("NegObs Ground"),
    anno::description("Triplanar-projected PBR with primvar cross-fade blending and anti-tiling"),
    anno::author("NegObs look-check pipeline"),
    anno::version(1, 3, 0)
]] = let {

    NegObsLayer A = negobs_layer(
        diffuse_texture_a, normalmap_texture_a, roughness_texture_a,
        texture_scale_a, texture_rotate_a, rough_floor_a, rough_mult_a,
        bump_factor * bump_factor_a, flip_tangent_u, flip_tangent_v,
        1.0, patch_wavelength_a, macro_amp_a, macro_wavelength_a,
        desat_bright_a, rough_noise_a, rough_noise_wavelength_a,
        specular_level_a, tri_dither, tri_dither_wavelength, tri_weight_exp);

    NegObsLayer B = negobs_layer(
        diffuse_texture_b, normalmap_texture_b, roughness_texture_b,
        texture_scale_b, texture_rotate_b, rough_floor_b, rough_mult_b,
        bump_factor * bump_factor_b, flip_tangent_u, flip_tangent_v,
        1.0, patch_wavelength_b, macro_amp_b, macro_wavelength_b,
        desat_bright_b, rough_noise_b, rough_noise_wavelength_b,
        specular_level_b, tri_dither, tri_dither_wavelength, tri_weight_exp);

    // 정점 primvar 크로스페이드 + 고주파 노이즈로 경계 프랙탈화
    // (w(1-w) 가중 → w=0/1에서 노이즈 기여 0: 순수 영역 재질과 픽셀 연속)
    float w0 = use_blend
        ? math::clamp(blend_use_wb
                      ? scene::data_lookup_float("blend_wb", blend_default)
                      : scene::data_lookup_float("blend_tw", blend_default),
                      0.0, 1.0)
        : 0.0;
    float w = math::clamp(
        w0 + blend_edge_noise *
            (negobs_noise(blend_edge_wavelength, 2, 7.9) - 0.5) * 4.0 *
            w0 * (1.0 - w0),
        0.0, 1.0);

    color albedo = use_blend ? math::lerp(A.albedo, B.albedo, w) : A.albedo;
    float rough = use_blend ? math::lerp(A.rough, B.rough, w) : A.rough;
    float3 nrm = use_blend
        ? math::normalize(math::lerp(A.nrm, B.nrm, w)) : A.nrm;
    float spec = use_blend ? math::lerp(A.spec, B.spec, w) : A.spec;

    //  BSDF — OmniPBRBase(metalness=0, coat 없음) 경로 축약 이식  //
    bsdf diffuse_bsdf = df::weighted_layer(
        weight: 1.0,
        layer: df::diffuse_reflection_bsdf(tint: albedo, roughness: 0.0),
        base: bsdf(),
        normal: nrm);

    float rough_sq = rough * rough;
    bsdf ggx_bsdf = df::microfacet_ggx_smith_bsdf(
        roughness_u: rough_sq,
        roughness_v: rough_sq,
        tint: color(1.0),
        mode: df::scatter_reflect);

    bsdf surf_bsdf = df::custom_curve_layer(
        normal_reflectivity: 0.08,
        grazing_reflectivity: 1.0,
        exponent: 5.0,
        weight: spec,
        layer: ggx_bsdf,
        base: diffuse_bsdf,
        normal: nrm);

} in material(
    surface: material_surface(scattering: surf_bsdf),
    geometry: material_geometry()
);
